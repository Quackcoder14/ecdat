# Database
DATABASE_URL=postgresql://ecdat:ecdat_secure_password@localhost:5432/ecdat

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-this-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Artifact Storage
ARTIFACT_STORAGE_PATH=/app/artifacts
MAX_ARTIFACT_SIZE=104857600

# Scan
SCAN_TIMEOUT_SECONDS=300

# LLM
LLM_PROVIDER=mock
LLM_MODEL=demo-model
LLM_BASE_URL=
LLM_API_KEY=

# Demo Mode
DEMO_MODE=true